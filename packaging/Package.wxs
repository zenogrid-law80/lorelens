<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="LoreLens"
    Manufacturer="ZenoGrid Co., Ltd."
    Version="$(var.Version).0"
    UpgradeCode="6D7D0B1B-8C8D-4A28-9E9A-7B9B6D0D0E10"
    Scope="perMachine">

    <!-- Keep UpgradeCode stable so new MSI packages replace existing installations.
         Remove the old product inside the transaction before copying files, including
         unversioned Rust executables; a failed upgrade can roll back the removal. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of LoreLens is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Close the app before files-in-use validation and before MajorUpgrade
         removes the old product. Keep this action immediate-only: deferred
         close/reboot/termination options cannot run before InstallInitialize. -->
    <util:CloseApplication
      Id="CloseLoreLens"
      Target="lorelens.exe"
      Condition="NOT UPGRADINGPRODUCTCODE"
      Description="LoreLens is running. Finish any operations, then close LoreLens and select Retry. Select Ignore to let setup close LoreLens, or Abort to cancel setup."
      PromptToContinue="yes"
      CloseMessage="yes"
      RebootPrompt="no"
      Timeout="15"
      Property="LORELENS_RUNNING" />
    <CustomAction
      Id="FailIfLoreLensRunning"
      Error="LoreLens is still running. Close all LoreLens windows and run setup again." />
    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)" Before="InstallValidate" Condition="VersionNT &gt; 400 AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="FailIfLoreLensRunning" After="Wix4CloseApplications_$(sys.BUILDARCHSHORT)" Condition="LORELENS_RUNNING AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LoreLens">
        <Component Id="ApplicationComponent" Guid="*">
          <File Id="LoreLensExe" Source="$(var.ExePath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="LoreLens">
        <Component Id="StartMenuComponent" Guid="*">
          <Shortcut Id="LoreLensStartMenuShortcut" Name="LoreLens" Target="[INSTALLFOLDER]lorelens.exe" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\LoreLens" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="LoreLens" Level="1">
      <ComponentRef Id="ApplicationComponent" />
      <ComponentRef Id="StartMenuComponent" />
    </Feature>
  </Package>
</Wix>
